{
    "name": "bygagashek/booking-api",
    "description": "Table booking REST API in plain PHP: idempotent creation, row locking against double booking, signed payment webhooks.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Pavel Makarov",
            "email": "pavelmakarov2107@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "BookingApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BookingApi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
